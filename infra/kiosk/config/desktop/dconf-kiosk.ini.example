# Perfil candidato para Ubuntu Desktop endurecido (Opción B).
# No aplicar automáticamente: las claves dependen de la versión de GNOME y
# deben comprobarse en la unidad física durante Fase 0.

[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/desktop/screensaver]
lock-enabled=false

[org/gnome/settings-daemon/plugins/power]
idle-dim=false
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'

[org/gnome/desktop/notifications]
show-in-lock-screen=false
