generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DeviceType {
  KIOSK
  PRINT_AGENT
  DISPLAY
}

enum UserRole {
  SUPERADMINISTRADOR
  ADMINISTRADOR
  SUPERVISOR
  ASESOR
}

enum AdminAuditActorType {
  UNAUTHENTICATED
  USER
}

enum AdminAuditResourceType {
  ORGANIZATION
  SITE
  SERVICE
  ROOM
  COUNTER
  USER
  SERVICE_ASSIGNMENT
  DEVICE
}

enum AdminAuditAction {
  CREATE
  UPDATE
  ENABLE
  DISABLE
  ASSIGN
  UNASSIGN
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(160)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)

  sites              Site[]
  services           Service[]
  rooms              Room[]
  counters           Counter[]
  users              User[]
  serviceAssignments ServiceAssignment[]
  devices            Device[]
  adminAuditLogs     AdminAuditLog[]
  authSessions       AuthSession[]

  @@index([active])
  @@map("organizations")
}

model Site {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String   @db.VarChar(160)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  services       Service[]
  rooms          Room[]
  counters       Counter[]
  users          User[]
  devices        Device[]
  adminAuditLogs AdminAuditLog[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, active])
  @@map("sites")
}

model Service {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  siteId         String   @db.Uuid
  name           String   @db.VarChar(160)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site                @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Restrict)
  assignments  ServiceAssignment[]

  @@unique([organizationId, id])
  @@unique([siteId, name])
  @@index([organizationId, siteId, active])
  @@map("services")
}

model Room {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  siteId         String   @db.Uuid
  name           String   @db.VarChar(160)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site         @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Restrict)
  counters     Counter[]
  devices      Device[]

  @@unique([organizationId, id])
  @@unique([organizationId, siteId, id])
  @@unique([siteId, name])
  @@index([organizationId, siteId, active])
  @@map("rooms")
}

model Counter {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  siteId         String   @db.Uuid
  roomId         String?  @db.Uuid
  name           String   @db.VarChar(120)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site         @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Restrict)
  room         Room?        @relation(fields: [organizationId, siteId, roomId], references: [organizationId, siteId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([siteId, name])
  @@index([organizationId, siteId, active])
  @@map("counters")
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @db.Uuid
  siteId              String?   @db.Uuid
  email               String    @db.VarChar(320)
  fullName            String    @db.VarChar(160)
  role                UserRole  @default(ASESOR)
  passwordHash        String?   @db.VarChar(255)
  active              Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lastFailedLoginAt   DateTime? @db.Timestamptz(3)
  lockedUntil         DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @default(now()) @db.Timestamptz(3)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site           Site?               @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Restrict)
  assignments    ServiceAssignment[]
  adminAuditLogs AdminAuditLog[]     @relation("AdminAuditActor")
  authSessions   AuthSession[]

  @@unique([organizationId, id])
  @@unique([organizationId, email])
  @@index([organizationId, siteId, active])
  @@map("users")
}

model AuthSession {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  tokenHash      String    @unique @db.VarChar(64)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime  @db.Timestamptz(3)
  lastSeenAt     DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("auth_sessions")
}

model ServiceAssignment {
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  serviceId      String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  service      Service      @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, userId, serviceId])
  @@index([organizationId, serviceId])
  @@map("service_assignments")
}

model Device {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  siteId         String     @db.Uuid
  roomId         String?    @db.Uuid
  name           String     @db.VarChar(120)
  type           DeviceType
  enabled        Boolean    @default(true)
  metadata       Json       @default("{}")
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site         @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Restrict)
  room         Room?        @relation(fields: [organizationId, siteId, roomId], references: [organizationId, siteId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([siteId, name])
  @@index([organizationId, siteId, type, enabled])
  @@map("devices")
}

model AdminAuditLog {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  siteId         String?                @db.Uuid
  resourceType   AdminAuditResourceType
  resourceId     String                 @db.VarChar(160)
  action         AdminAuditAction
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  actorUserId    String?                @db.Uuid
  actorType      AdminAuditActorType    @default(UNAUTHENTICATED)
  correlationId  String?                @db.VarChar(64)
  metadata       Json                   @default("{}")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site?        @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Restrict)
  actorUser    User?        @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId])
  @@index([actorUserId, createdAt])
  @@map("admin_audit_logs")
}
